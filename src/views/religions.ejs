<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <%- include('../partials/_head') %>
    <link rel="stylesheet" href="/vendors/mdi/css/materialdesignicons.min.css">
    <link rel="stylesheet" href="/vendors/ti-icons/css/themify-icons.css">
    <link rel="stylesheet" href="/vendors/css/vendor.bundle.base.css">
    <link rel="stylesheet" href="/vendors/font-awesome/css/font-awesome.min.css">
    <link rel="stylesheet" href="/css/style.css">

    <style>
      .editable {
        background-color: #fdfd96;
        cursor: text;
      }
      .editable:focus {
        outline: 2px solid #4caf50;
      }
    </style>
  </head>
  <body>
    <div class="container-scroller">
      <%- include('../partials/_navbar') %>
      <div class="container-fluid page-body-wrapper">
        <%- include('../partials/_sidebar') %>
        <div class="main-panel">
          <div class="content-wrapper">
            <div class="page-header">
              <h3 class="page-title">Manage Religions & Sub Religions</h3>
            </div>

            <!-- Religion Section -->
            <div class="row mb-4">
              <div class="col-md-6">
                <input type="text" id="religionSearch" class="form-control" placeholder="Search Religion">
              </div>
              <div class="col-md-6 text-end">
                <button class="btn btn-danger" id="addReligionBtn">Add Religion</button>
              </div>
            </div>

            <div class="row">
              <div class="col-lg-12 grid-margin stretch-card">
                <div class="card">
                  <div class="card-body">
                    <h4 class="card-title">Religions</h4>
                    <div class="table-responsive">
                      <table class="table table-striped" id="religionsTable">
                        <thead>
                          <tr>
                            <th>#</th>
                            <th>Religion Name</th>
                            <th>Status</th>
                            <th>Actions</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% if (religions && religions.length > 0) { %>
                            <% religions.forEach((rel, index) => { %>
                              <tr data-id="<%= rel.id %>">
                                <td><%= index + 1 %></td>
                                <td contenteditable="true" class="editable" data-field="religion_name"><%= rel.religion_name %></td>
                                <td>
                                  <label class="badge <%= rel.status === 'active' ? 'badge-success' : 'badge-danger' %> toggle-religion-status"
                                    style="cursor:pointer;" data-id="<%= rel.id %>" data-status="<%= rel.status %>">
                                    <%= rel.status === 'active' ? 'Active' : 'Inactive' %>
                                  </label>
                                </td>
                                <td>
                                  <button class="btn btn-sm btn-info view-subreligions" data-id="<%= rel.id %>" data-name="<%= rel.religion_name %>">Subreligions</button>
                                  <button class="btn btn-sm btn-danger delete-religion" data-id="<%= rel.id %>">Delete</button>
                                </td>
                              </tr>
                            <% }) %>
                          <% } else { %>
                            <tr>
                              <td colspan="4" class="text-center text-muted">No religions found</td>
                            </tr>
                          <% } %>
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Sub Religion Section -->
            <div class="row mt-5" id="subReligionSection" style="display:none;">
              <div class="col-lg-12 grid-margin stretch-card">
                <div class="card">
                  <div class="card-body">
                    <h4 class="card-title">Sub Religions of <span id="currentReligionName"></span></h4>
                    <button class="btn btn-danger mb-3" id="addSubReligionBtn">Add Sub Religion</button>
                    <input type="text" id="searchBox" placeholder="Search Sub Religion..." class="form-control mb-3">
                    <div class="table-responsive">
                      <table class="table table-striped" id="subReligionsTable">
                        <thead>
                          <tr>
                            <th>#</th>
                            <th>Sub Religion Name</th>
                            <th>Status</th>
                            <th>Actions</th>
                          </tr>
                        </thead>
                        <tbody id="subReligionBody">
                          <!-- Filled by JS -->
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </div>
            </div>

          </div>
          <%- include('../partials/_footer') %>
        </div>
      </div>
    </div>

<!-- Add Religion Modal -->
<div class="modal fade" id="addReligionModal" tabindex="-1" aria-labelledby="addReligionLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content border-danger">
      <div class="modal-header bg-danger text-white">
        <h5 class="modal-title" id="addReligionLabel">Add New Religion</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <input type="text" id="newReligionName" class="form-control" placeholder="Enter religion name">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger" id="saveReligionBtn">Add Religion</button>
      </div>
    </div>
  </div>
</div>

<!-- Add Sub Religion Modal -->
<div class="modal fade" id="addSubReligionModal" tabindex="-1" aria-labelledby="addSubReligionLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content border-danger">
      <div class="modal-header bg-danger text-white">
        <h5 class="modal-title" id="addSubReligionLabel">Add Sub Religion</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <input type="text" id="newSubReligionName" class="form-control" placeholder="Enter sub religion name">
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-danger" id="saveSubReligionBtn">Add Sub Religion</button>
      </div>
    </div>
  </div>
</div>

<!-- Custom Bootstrap Modal for Alerts / Confirmations -->
<div class="modal fade" id="customAlertModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content border-danger">
      <div class="modal-header bg-danger text-white">
        <h5 class="modal-title" id="customAlertTitle">Alert</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" id="customAlertMessage"></div>
      <div class="modal-footer" id="customAlertButtons"></div>
    </div>
  </div>
</div>

<!-- Scripts -->
<script src="/vendors/js/vendor.bundle.base.js"></script>
<script src="/js/off-canvas.js"></script>
<script src="/js/misc.js"></script>
<script src="/js/settings.js"></script>
<script src="/js/todolist.js"></script>
<%- include('../partials/_script') %>

<script>
function showCustomModal({ title = "Alert", message = "", buttons = [] }) {
  const modalEl = document.getElementById("customAlertModal");
  document.getElementById("customAlertTitle").textContent = title;
  document.getElementById("customAlertMessage").innerHTML = message;

  const footer = document.getElementById("customAlertButtons");
  footer.innerHTML = "";

  buttons.forEach(btn => {
    const button = document.createElement("button");
    button.textContent = btn.text;
    button.className = "btn " + (btn.class || "btn-secondary");
    button.addEventListener("click", () => {
      if (btn.onClick) btn.onClick();
      const modal = bootstrap.Modal.getInstance(modalEl);
      modal.hide();
    });
    footer.appendChild(button);
  });

  const modal = new bootstrap.Modal(modalEl);
  modal.show();
}

// Religion Search
document.getElementById('religionSearch').addEventListener('input', function () {
  const filter = this.value.toLowerCase();
  document.querySelectorAll('#religionsTable tbody tr').forEach(row => {
    const name = row.children[1].textContent.toLowerCase();
    row.style.display = name.includes(filter) ? '' : 'none';
  });
});

// Toggle Religion Status
document.querySelectorAll('.toggle-religion-status').forEach(badge => {
  badge.addEventListener('click', function () {
    const id = this.dataset.id;
    const newStatus = this.dataset.status === 'active' ? 'inactive' : 'active';

    fetch('/religions/status-toggle', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id, status: newStatus })
    })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        this.dataset.status = newStatus;
        this.classList.toggle('badge-success');
        this.classList.toggle('badge-danger');
        this.textContent = newStatus === 'active' ? 'Active' : 'Inactive';
      } else {
        showCustomModal({ title: "Error", message: "Failed to update status", buttons: [{ text: "OK", class: "btn-primary" }] });
      }
    });
  });
});

// Inline Religion Editing
document.querySelectorAll('.editable').forEach(cell => {
  cell.addEventListener('blur', function () {
    const id = this.closest('tr').dataset.id;
    const field = this.dataset.field;
    const value = this.textContent.trim();

    fetch('/religions/update-field', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id, field, value })
    });
  });
});

// View Sub Religions
document.querySelectorAll('.view-subreligions').forEach(btn => {
  btn.addEventListener('click', function () {
    const religionId = this.dataset.id;
    const religionName = this.dataset.name;
    document.getElementById('currentReligionName').textContent = religionName;
    document.getElementById('subReligionSection').style.display = 'block';

    fetch(`/subreligions/${religionId}`)
      .then(res => res.json())
      .then(data => {
        const tbody = document.getElementById('subReligionBody');
        tbody.innerHTML = '';
        if (!data.success || data.data.length === 0) {
          tbody.innerHTML = '<tr><td colspan="4" class="text-center text-muted">No sub religions found</td></tr>';
        } else {
          data.data.forEach((sub, index) => {
            tbody.innerHTML += `
              <tr data-id="${sub.id}">
                <td>${index + 1}</td>
                <td contenteditable="true" class="editable" data-field="name">${sub.name}</td>
                <td>
                  <label class="badge ${sub.status === 'active' ? 'badge-success' : 'badge-danger'} toggle-subreligion-status"
                    style="cursor:pointer;" data-id="${sub.id}" data-status="${sub.status}">
                    ${sub.status === 'active' ? 'Active' : 'Inactive'}
                  </label>
                </td>
                <td>
                  <button class="btn btn-sm btn-danger delete-subreligion" data-id="${sub.id}">Delete</button>
                </td>
              </tr>
            `;
          });
        }
      });
  });
});

// Toggle Sub Religion Status
document.addEventListener("click", function (e) {
  if (e.target.classList.contains("toggle-subreligion-status")) {
    const id = e.target.dataset.id;
    const currentStatus = e.target.dataset.status;
    const newStatus = currentStatus === "active" ? "inactive" : "active";

    fetch("/subreligions/status-toggle", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ id, status: newStatus })
    })
    .then(res => res.json())
    .then(data => {
      if (data.success) {
        e.target.dataset.status = newStatus;
        e.target.textContent = newStatus === "active" ? "Active" : "Inactive";
        e.target.classList.toggle("badge-success");
        e.target.classList.toggle("badge-danger");
      } else {
        showCustomModal({ title: "Error", message: "Failed to update status", buttons: [{ text: "OK", class: "btn-primary" }] });
      }
    });
  }
});

// Inline Sub Religion Editing
document.addEventListener('blur', function (e) {
  if (e.target.classList.contains('editable') && e.target.closest('#subReligionsTable')) {
    const id = e.target.closest('tr').dataset.id;
    const value = e.target.textContent.trim();

    fetch('/subreligions/update-field', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id, value })
    })
    .then(res => res.json())
    .then(data => {
      if (!data.success) {
        showCustomModal({ title: "Error", message: "Failed to update sub religion", buttons: [{ text: "OK", class: "btn-primary" }] });
      }
    });
  }
}, true);

// Search Sub Religions
document.getElementById("searchBox").addEventListener("keyup", function() {
  let value = this.value.toLowerCase();
  let rows = document.querySelectorAll("#subReligionsTable tbody tr");
  rows.forEach(row => {
    let text = row.innerText.toLowerCase();
    row.style.display = text.includes(value) ? "" : "none";
  });
});

// Delete Religion
document.querySelectorAll(".delete-religion").forEach(btn => {
  btn.addEventListener("click", function () {
    const id = this.dataset.id;
    const row = this.closest("tr");

    showCustomModal({
      title: "Confirm Delete",
      message: "Are you sure you want to delete this religion?",
      buttons: [
        { text: "Cancel", class: "btn-secondary" },
        { 
          text: "Delete", 
          class: "btn-danger", 
          onClick: () => {
            fetch(`/religions/delete/${id}`)
              .then(res => res.json())
              .then(data => {
                if (data.success) {
                  row.remove();
                  showCustomModal({ title: "Success", message: data.message, buttons: [{ text: "OK", class: "btn-primary" }] });
                } else {
                  showCustomModal({ title: "Error", message: "Failed to delete religion", buttons: [{ text: "OK", class: "btn-primary" }] });
                }
              });
          } 
        }
      ]
    });
  });
});

// Delete Sub Religion
document.addEventListener("click", function(e) {
  if (e.target.classList.contains("delete-subreligion")) {
    const id = e.target.dataset.id;
    const row = e.target.closest("tr");

    showCustomModal({
      title: "Confirm Delete",
      message: "Are you sure you want to delete this sub religion?",
      buttons: [
        { text: "Cancel", class: "btn-secondary" },
        {
          text: "Delete",
          class: "btn-danger",
          onClick: () => {
            fetch(`/subreligions/delete/${id}`)
              .then(res => res.json())
              .then(data => {
                if (data.success) {
                  row.remove();
                  showCustomModal({ title: "Success", message: data.message, buttons: [{ text: "OK", class: "btn-primary" }] });
                } else {
                  showCustomModal({ title: "Error", message: data.message || "Failed to delete sub religion", buttons: [{ text: "OK", class: "btn-primary" }] });
                }
              });
          }
        }
      ]
    });
  }
});

// Add Religion Modal
document.getElementById("addReligionBtn").addEventListener("click", () => {
  const modal = new bootstrap.Modal(document.getElementById('addReligionModal'));
  document.getElementById('newReligionName').value = '';
  modal.show();
});

// Save Religion
document.getElementById("saveReligionBtn").addEventListener("click", () => {
  const religionName = document.getElementById('newReligionName').value.trim();
  if (!religionName) return showCustomModal({ title: "Warning", message: "Please enter a religion name", buttons: [{ text: "OK", class: "btn-primary" }] });

  fetch("/religions/add", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ religion_name: religionName })
  })
  .then(res => res.json())
  .then(data => {
    if (data.success) {
      showCustomModal({ title: "Success", message: "Religion added successfully!", buttons: [{ text: "OK", class: "btn-primary" }] });
      location.reload();
    } else {
      showCustomModal({ title: "Error", message: "Failed to add religion: " + (data.message || ""), buttons: [{ text: "OK", class: "btn-primary" }] });
    }
  });
});

// Add Sub Religion Modal
document.getElementById("addSubReligionBtn").addEventListener("click", () => {
  const modal = new bootstrap.Modal(document.getElementById('addSubReligionModal'));
  document.getElementById('newSubReligionName').value = '';
  modal.show();
});

// Save Sub Religion
document.getElementById("saveSubReligionBtn").addEventListener("click", () => {
  const subName = document.getElementById('newSubReligionName').value.trim();
  const religionId = document.querySelector(".view-subreligions[data-id]")?.dataset.id;
  if (!subName) return showCustomModal({ title: "Warning", message: "Please enter a sub religion name", buttons: [{ text: "OK", class: "btn-primary" }] });

  fetch("/subreligions/add", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ religion_id: religionId, name: subName })
  })
  .then(res => res.json())
  .then(data => {
    if (data.success) {
      showCustomModal({ title: "Success", message: "Sub Religion added successfully!", buttons: [{ text: "OK", class: "btn-primary" }] });
      location.reload();
    } else {
      showCustomModal({ title: "Error", message: "Failed to add sub religion: " + (data.message || ""), buttons: [{ text: "OK", class: "btn-primary" }] });
    }
  });
});
</script>
  </body>
</html>
