<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Satphere Admin Panel</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
  <style>
    :root {
      --main-bg: #ffe5ec;
      --main-color: #ff4d6d;
      --secondary-color: #ff758f;
      --text-color: #333;
      --card-bg: #fff;
    }

    body {
      margin: 0;
      background-color: var(--main-bg);
      font-family: "Poppins", sans-serif;
      color: var(--text-color);
      overflow-x: hidden;
    }

    .wrapper {
      display: flex;
      height: 100vh;
      overflow: hidden;
      position: relative;
    }

    /* Sidebar */
    .sidebar {
      width: 250px;
      background: linear-gradient(180deg, var(--main-color), var(--secondary-color));
      color: #fff;
      flex-shrink: 0;
      transition: all 0.3s ease;
      overflow-y: auto;
      position: relative;
      z-index: 2000;
    }

    .sidebar h3 {
      text-align: center;
      margin: 20px 0;
      font-weight: bold;
    }

    .sidebar a {
      color: #fff;
      text-decoration: none;
      display: block;
      padding: 10px 20px;
      border-radius: 8px;
      margin: 5px 10px;
      transition: background 0.3s;
      white-space: nowrap;
    }

    .sidebar a:hover,
    .sidebar a.active {
      background-color: rgba(255, 255, 255, 0.2);
    }

    .sidebar i {
      width: 25px;
    }

    .submenu {
      padding-left: 35px;
      display: none;
    }

    .menu-toggle.active + .submenu {
      display: block;
    }

    /* Collapsed Sidebar */
    .collapsed {
      width: 80px;
    }
    .collapsed h3,
    .collapsed a span {
      display: none;
    }

    /* Main */
    .main {
      flex-grow: 1;
      display: flex;
      flex-direction: column;
      height: 100vh;
      overflow: hidden;
    }

    .navbar {
      background-color: #fff;
      box-shadow: 0 1px 4px rgba(0, 0, 0, 0.1);
      flex-shrink: 0;
      z-index: 1000;
    }

    .navbar-brand {
      color: var(--main-color);
      font-weight: bold;
    }

    .main-content {
      flex-grow: 1;
      overflow-y: auto;
      padding: 20px;
    }

    .card {
      border: none;
      border-radius: 15px;
      background-color: var(--card-bg);
      box-shadow: 0 4px 8px rgba(0, 0, 0, 0.05);
    }

    footer {
      background: #fff;
      padding: 10px;
      text-align: center;
      box-shadow: 0 -2px 5px rgba(0, 0, 0, 0.1);
      color: #666;
      flex-shrink: 0;
    }

    /* Scrollbars */
    .sidebar::-webkit-scrollbar,
    .main-content::-webkit-scrollbar {
      width: 6px;
    }
    .sidebar::-webkit-scrollbar-thumb,
    .main-content::-webkit-scrollbar-thumb {
      background: rgba(255, 77, 109, 0.4);
      border-radius: 10px;
    }

    /* Mobile Sidebar Hidden by Default */
    @media (max-width: 991px) {
      .sidebar {
        position: fixed;
        left: -250px;
        top: 0;
        height: 100vh;
        transition: left 0.3s ease;
        box-shadow: 2px 0 10px rgba(0, 0, 0, 0.3);
      }
      .sidebar.show {
        left: 0;
      }
      .overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 1500;
        display: none;
      }
      .overlay.show {
        display: block;
      }
    }
  </style>
</head>
<body>
  <div class="wrapper">
    <!-- Sidebar -->
    <div class="sidebar" id="sidebar">
      <h3>🌸 Satphere</h3>
      <a href="#" class="active"><i class="bi bi-speedometer2"></i><span> Dashboard</span></a>

      <!-- User Section -->
      <a href="#" class="menu-toggle"><i class="bi bi-person-lines-fill"></i><span> Users</span></a>
      <div class="submenu">
        <a href="#"><i class="bi bi-eye"></i> View Profile</a>
        <a href="#"><i class="bi bi-pencil-square"></i> Edit Profile</a>
        <a href="#"><i class="bi bi-table"></i> Users Table</a>
      </div>

      <!-- Notification Section -->
      <a href="#" class="menu-toggle"><i class="bi bi-bell"></i><span> Notifications</span></a>
      <div class="submenu">
        <a href="#"><i class="bi bi-bell-fill"></i> Show Notifications</a>
        <a href="#"><i class="bi bi-send"></i> Send Notification</a>
      </div>

      <a href="#"><i class="bi bi-chat-heart"></i><span> Match Users</span></a>
      <a href="#"><i class="bi bi-person-plus"></i><span> Friend Requests</span></a>
      <a href="#"><i class="bi bi-gem"></i><span> Premium Plans</span></a>
      <a href="#"><i class="bi bi-cash-coin"></i><span> Transactions</span></a>
      <a href="#"><i class="bi bi-image"></i><span> Banners</span></a>

      <hr class="text-white mx-3" />
      <a href="#"><i class="bi bi-person-circle"></i><span> Admin Profile</span></a>
      <a href="#"><i class="bi bi-lock"></i><span> Change Password</span></a>
      <a href="#"><i class="bi bi-box-arrow-right"></i><span> Logout</span></a>
    </div>

    <!-- Overlay for Mobile -->
    <div class="overlay" id="overlay"></div>

    <!-- Main -->
    <div class="main">
      <nav class="navbar d-flex justify-content-between px-3">
        <div class="d-flex align-items-center">
          <button class="btn btn-light me-2" id="toggleSidebar">
            <i class="bi bi-list text-danger fs-4"></i>
          </button>
          <span class="navbar-brand mb-0 h1">Admin Dashboard</span>
        </div>
        <div>
          <i class="bi bi-bell me-3 text-danger fs-5"></i>
          <i class="bi bi-person-circle text-danger fs-5"></i>
        </div>
      </nav>

      <div class="main-content">
        <div class="row g-4">
          <div class="col-md-3">
            <div class="card p-3 text-center">
              <i class="bi bi-people fs-1 text-danger"></i>
              <h5 class="mt-2">Total Users</h5>
              <h3>1,245</h3>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card p-3 text-center">
              <i class="bi bi-gem fs-1 text-danger"></i>
              <h5 class="mt-2">Premium Members</h5>
              <h3>345</h3>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card p-3 text-center">
              <i class="bi bi-cash-coin fs-1 text-danger"></i>
              <h5 class="mt-2">Transactions</h5>
              <h3>₹58,200</h3>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card p-3 text-center">
              <i class="bi bi-bell fs-1 text-danger"></i>
              <h5 class="mt-2">Notifications</h5>
              <h3>32</h3>
            </div>
          </div>
          
            <div class="col-md-3">
            <div class="card p-3 text-center">
              <i class="bi bi-people fs-1 text-danger"></i>
              <h5 class="mt-2">Total Users</h5>
              <h3>1,245</h3>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card p-3 text-center">
              <i class="bi bi-gem fs-1 text-danger"></i>
              <h5 class="mt-2">Premium Members</h5>
              <h3>345</h3>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card p-3 text-center">
              <i class="bi bi-cash-coin fs-1 text-danger"></i>
              <h5 class="mt-2">Transactions</h5>
              <h3>₹58,200</h3>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card p-3 text-center">
              <i class="bi bi-bell fs-1 text-danger"></i>
              <h5 class="mt-2">Notifications</h5>
              <h3>32</h3>
            </div>
          </div>
          
            <div class="col-md-3">
            <div class="card p-3 text-center">
              <i class="bi bi-people fs-1 text-danger"></i>
              <h5 class="mt-2">Total Users</h5>
              <h3>1,245</h3>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card p-3 text-center">
              <i class="bi bi-gem fs-1 text-danger"></i>
              <h5 class="mt-2">Premium Members</h5>
              <h3>345</h3>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card p-3 text-center">
              <i class="bi bi-cash-coin fs-1 text-danger"></i>
              <h5 class="mt-2">Transactions</h5>
              <h3>₹58,200</h3>
            </div>
          </div>
          <div class="col-md-3">
            <div class="card p-3 text-center">
              <i class="bi bi-bell fs-1 text-danger"></i>
              <h5 class="mt-2">Notifications</h5>
              <h3>32</h3>
            </div>
          </div>
          
        </div>
      </div>

      <footer>© 2025 Satphere Admin Panel</footer>
    </div>
  </div>

  <script>
    const sidebar = document.getElementById("sidebar");
    const toggleSidebar = document.getElementById("toggleSidebar");
    const overlay = document.getElementById("overlay");

    toggleSidebar.addEventListener("click", () => {
      if (window.innerWidth <= 991) {
        sidebar.classList.toggle("show");
        overlay.classList.toggle("show");
      } else {
        sidebar.classList.toggle("collapsed");
      }
    });

    overlay.addEventListener("click", () => {
      sidebar.classList.remove("show");
      overlay.classList.remove("show");
    });

    // Dropdown toggles
    document.querySelectorAll(".menu-toggle").forEach((toggle) => {
      toggle.addEventListener("click", () => {
        toggle.classList.toggle("active");
      });
    });
  </script>
</body>
</html>
