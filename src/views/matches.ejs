            <div
              class="page-header d-flex justify-content-between align-items-center flex-wrap"
            >
              <h3 class="page-title mb-2 mb-md-0">View All matches Users</h3>
              <div>
                <button
                  id="exportCsv"
                  class="btn btn-outline-primary btn-sm me-2"
                >
                  <i class="mdi mdi-file-delimited"></i> CSV
                </button>
                <button
                  id="exportPdf"
                  class="btn btn-outline-danger btn-sm me-2"
                >
                  <i class="mdi mdi-file-pdf"></i> PDF
                </button>
                <button
                  id="exportPrint"
                  class="btn btn-outline-secondary btn-sm"
                >
                  <i class="mdi mdi-printer"></i> Print
                </button>
              </div>
            </div>

            <div class="row mb-3">
              <div class="col-md-6">
              <input type="text" id="userSearch" class="form-control" placeholder="Search by User, Channel, Timestamp ">

              </div>
            </div>

            <div class="row">
              <div class="col-lg-12 grid-margin stretch-card">
                <div class="card">
                  <div class="card-body">
                    <h4 class="card-title">Matche Table</h4>
                    <div class="table-responsive">
<table class="table table-striped" id="matchesTable">
  <thead>
    <tr>
      <th>#</th>
      <th>User A</th>
      <th>User B</th>
      <th>Channel</th>
     
           <th>Timestamp</th>
           <th>Report</th>
      <!--<th>Ended At</th>-->
      <th>Status</th>

      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% if (matches && matches.length > 0) { %>
      <% matches.forEach((m, index) => { %>
        <tr>
          <td><%= index + 1 %></td>
          <td><%= m.user_a_name || '-' %></td>
          <td><%= m.user_b_name || '-' %></td>
          <td><%= m.channel_name %></td>
                   <td><%= m.started_at ? new Date(m.started_at).toLocaleString() : '-' %></td>
                   <td><%= m.last_message || '-' %></td>
         <!-- <td><%= m.ended_at ? new Date(m.ended_at).toLocaleString() : '-' %></td>-->
          <td>
            <button class="btn btn-sm toggle-status <%= m.status === 'pending' ? 'btn-warning' : (m.status === 'active' ? 'btn-success' : 'btn-danger') %>" 
              data-id="<%= m.id %>">
              <%= m.status.charAt(0).toUpperCase() + m.status.slice(1) %>
            </button>
          </td>

          <td>
            <button class="btn btn-sm btn-danger delete-match" data-id="<%= m.id %>">Delete</button>
          </td>
        </tr>
      <% }) %>
    <% } else { %>
      <tr>
        <td colspan="9" class="text-center text-muted">No matches found</td>
      </tr>
    <% } %>
  </tbody>
</table>
<p id="matchCount" class="mt-3 text-muted">Showing <%= matches.length %> records</p>


<!--row count total-->

                    </div>
                  </div>
                </div>
              </div>
              
                      <div id="successMsgContainer"></div>
            </div>

          </div>
          <%- include('../partials/_footer') %> 
        </div>
      </div>
    </div>

    <!-- Scripts -->
    <script src="vendors/js/vendor.bundle.base.js"></script>
    <script src="js/off-canvas.js"></script>
    <script src="js/misc.js"></script>
    <script src="js/settings.js"></script>
    <script src="js/todolist.js"></script>
    <script src="js/jquery.cookie.js"></script>
    <%- include('../partials/_script') %> 

    <!-- Search Filter Script -->

<script>
document.getElementById("userSearch").addEventListener("input", function () {
  const searchTerm = this.value.toLowerCase();
  const rows = document.querySelectorAll("#matchesTable tbody tr");

  rows.forEach(row => {
    const userA = row.cells[1]?.textContent.toLowerCase() || '';
    const userB = row.cells[2]?.textContent.toLowerCase() || '';
    const channel = row.cells[3]?.textContent.toLowerCase() || '';
    const timestamp = row.cells[4]?.textContent.toLowerCase() || '';
    const status = row.cells[5]?.textContent.toLowerCase() || '';

    if (
      userA.includes(searchTerm) ||
      userB.includes(searchTerm) ||
      channel.includes(searchTerm) ||
      timestamp.includes(searchTerm) ||
      status.includes(searchTerm)
    ) {
      row.style.display = "";
    } else {
      row.style.display = "none";
    }
  });
});

</script>



<script>
// Toggle status
document.querySelectorAll('.toggle-status').forEach(btn => {
  btn.addEventListener('click', async function() {
    const id = this.getAttribute('data-id');
    const current = this.textContent.trim().toLowerCase();
    let newStatus;
    if(current === 'pending') newStatus = 'active';
    else if(current === 'active') newStatus = 'ended';
    else newStatus = 'pending';

    try {
      const res = await fetch(`/matches/${id}/status`, {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ status: newStatus })
      });
      const data = await res.json();
      if(data.success){
        this.textContent = newStatus.charAt(0).toUpperCase() + newStatus.slice(1);
        this.className = 'btn btn-sm toggle-status ' + 
          (newStatus==='pending'?'btn-warning':(newStatus==='active'?'btn-success':'btn-danger'));
      } else alert(data.msg);
    } catch(err){ console.error(err); alert("Error updating status"); }
  });
});

// Delete match permanently
document.querySelectorAll('.delete-match').forEach(btn => {
  btn.addEventListener('click', async function() {
    const id = this.getAttribute('data-id');
    const row = this.closest('tr');
    if(!confirm('Are you sure you want to permanently delete this match?')) return;

    try {
      const res = await fetch(`/matches/${id}`, { method: 'DELETE' });
      const data = await res.json();
      if(data.success){
        row.remove();
        const count = document.getElementById('matchCount');
        const current = parseInt(count.textContent.replace(/\D/g,'')) - 1;
        count.textContent = `Showing ${current} records`;
      } else alert(data.msg);
    } catch(err){ console.error(err); alert("Error deleting match"); }
  });
});

</script>


  </body>
</html>
