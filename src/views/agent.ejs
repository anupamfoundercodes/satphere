            <div
              class="page-header d-flex justify-content-between align-items-center flex-wrap"
            >
              <h3 class="page-title mb-2 mb-md-0">View All Vendors</h3>
              <div>
                <button
                  id="exportCsv"
                  class="btn btn-outline-primary btn-sm me-2"
                >
                  <i class="mdi mdi-file-delimited"></i> CSV
                </button>
                <button
                  id="exportPdf"
                  class="btn btn-outline-danger btn-sm me-2"
                >
                  <i class="mdi mdi-file-pdf"></i> PDF
                </button>
                <button
                  id="exportPrint"
                  class="btn btn-outline-secondary btn-sm"
                >
                  <i class="mdi mdi-printer"></i> Print
                </button>
              </div>
            </div>

            <div class="row mb-3">
              <div class="col-md-6">
                <input type="text" id="userSearch" class="form-control" placeholder="Search by Name, State, District">
              </div>
            </div>

            <div class="row">
              <div class="col-lg-12 grid-margin stretch-card">
                <div class="card">
                  <div class="card-body">
                    <h4 class="card-title">Vendor Table</h4>
                    <div class="table-responsive">
                      <table class="table table-striped" id="usersTable">
                        <thead>
                          <tr>
                            <th>#</th>
                            <!--<th>Photo</th>-->
                            <th>Name</th>
                            <th>Email</th>
                            <th>Phone</th>
                            <th>State</th>
                            <th>District</th>
                            <th>Shop No.</th>
                            <!--<th>Profile</th>-->
                            <!--<th>Sarthi Code</th>-->
                            <th>Status</th>
                            <th>Actions</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% if (users && users.length > 0) { %>
                            <% users.forEach((user, index) => { %>
                              <tr>
                                <td><%= index + 1 %></td>
                                <!--<td class="py-1">
                                  <img src="<%= user.img || '/im]=ages/faces-clipart/default.png' %>" alt="user" />
                                </td>-->
                                <td><%= user.name %></td>
                                <td><%= user.email %></td>
                                <td><%= user.phone %></td>
                                <td><%= user.state %></td>
                                <td><%= user.district %></td>

                                <td><%= user.card_no %></td>
                               <!-- <td><%= user.profile %></td>-->
                                <!--<td><%= user.referral_code %></td>-->
                                <td>
                                  <button
                                    class="btn btn-sm toggle-status-user <%= user.status === 'active' ? 'btn-success' : 'btn-danger' %>"
                                    data-user-id="<%= user.id %>"
                                  >
                                    <%= user.status === 'active' ? 'Active' : 'Inactive' %>
                                  </button>
                                </td>
                                <td>
                                  <a href="/viewagent/<%= user.id %>" class="btn btn-sm btn-info">View</a>
                                  <a href="/editagent/<%= user.id %>" class="btn btn-sm btn-warning">Edit</a>
                                  <a href="javascript:void(0)" 
                                  class="btn btn-sm btn-danger delete-user" 
                                  data-user-id="<%= user.id %>">Delete</a>

                                </td>
                              </tr>
                            <% }) %>
                          <% } else { %>
                            <tr>
                              <td colspan="9" class="text-center text-muted">No users found</td>
                            </tr>
                          <% } %>
                        </tbody>
                      </table>
                      <p id="vendorCount" class="mt-3 text-muted">Showing <%= users.length %> vendors</p>
                    </div>
                  </div>
                </div>
              </div>
                      

                      <div id="successMsgContainer"></div>
            </div>

          </div>
          <%- include('../partials/_footer') %> 
        </div>
      </div>
