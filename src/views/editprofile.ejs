<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Edit User</title>
  <%- include('../partials/_head') %>

  <link rel="stylesheet" href="/vendors/mdi/css/materialdesignicons.min.css">
  <link rel="stylesheet" href="/vendors/ti-icons/css/themify-icons.css">
  <link rel="stylesheet" href="/vendors/font-awesome/css/font-awesome.min.css">
  <link rel="stylesheet" href="/vendors/css/vendor.bundle.base.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js/public/assets/styles/choices.min.css" />
  <link rel="stylesheet" href="/css/style.css">

  <style>
    .form-control { border-radius: 10px; }
    .profile-img-box {
      text-align: center; padding: 10px;
      background: #f9f9f9; border-radius: 8px; border: 1px solid #ddd;
    }
    .profile-img-box img {
      max-width: 120px; border-radius: 50%;
      border: 2px solid #cce0ff; padding: 5px;
    }
    .section-title { font-size: 20px; font-weight: 600; margin-top: 25px; margin-bottom: 10px; }
  </style>
</head>

<body>

<div class="container-scroller">
  <%- include('../partials/_navbar') %>

  <div class="container-fluid page-body-wrapper">
    <%- include('../partials/_sidebar') %>

    <div class="main-panel">
      <div class="content-wrapper">

        <h3 class="page-title mt-2">Edit User Profile</h3>

        <div class="card">
          <div class="card-body">

            <% if (users && users.length > 0) { %>
            <% const u = users[0]; %>

            <form id="editUserForm">

              <input type="hidden" name="id" value="<%= u.id %>">

              <!-- IMAGE MODAL -->
              <div id="imgModal" class="img-modal">
                <span class="img-modal-close">&times;</span>
                <img class="img-modal-content" id="modalImg">
              </div>

              <!-- ░░░░░░░░░░ SECTION 1 : PROFILE PICTURE ░░░░░░░░░░ -->
              <div class="section-title">Profile Picture</div>

              <div class="profile-img-box">
                <img id="profilePreview" src="<%= u.img || '/images/default-profile.png' %>">
                <input type="file" id="profileImg" accept="image/*" class="form-control mt-2">
              </div>

              <!-- ░░░░░░░░░░ SECTION 2 : PROFILE ░░░░░░░░░░ -->
              <div class="section-title">Profile</div>

              <div class="row">
                <div class="col-md-6 mt-2">
                  <label>Mobile No</label>
                  <input type="text" name="mobile_no" class="form-control" value="<%= u.mobile_no %>">
                </div>
                <div class="col-md-6 mt-2">
                  <label>Email</label>
                  <input type="email" name="email" class="form-control" value="<%= u.email %>">
                </div>

                <div class="col-md-6 mt-2">
                  <label>First Name</label>
                  <input type="text" name="first_name" class="form-control" value="<%= u.first_name %>">
                </div>
                <div class="col-md-6 mt-2">
                  <label>Last Name</label>
                  <input type="text" name="last_name" class="form-control" value="<%= u.last_name %>">
                </div>

                <div class="col-md-6 mt-2">
                  <label>Gender</label>
                  <select name="gender" class="form-control">
                    <option value="male" <%= u.gender=='male'?'selected':'' %>>Male</option>
                    <option value="female" <%= u.gender=='female'?'selected':'' %>>Female</option>
                    <option value="other" <%= u.gender=='other'?'selected':'' %>>Other</option>
                  </select>
                </div>

                <div class="col-md-6 mt-2">
                  <label>DOB</label>
                  <input type="date" name="dob" class="form-control"
                    value="<%= u.dob ? u.dob.toISOString().split('T')[0] : '' %>">
                </div>
              </div>

              <!-- ░░░░░░░░░░ SECTION 3 : BASIC INFORMATION ░░░░░░░░░░ -->
              <div class="section-title">Basic Information</div>

              <div class="row">
                <div class="col-md-6 mt-2">
                  <label>State</label>
                  <input type="text" name="state" class="form-control" value="<%= u.state %>">
                </div>
                <div class="col-md-6 mt-2">
                  <label>City</label>
                  <input type="text" name="city" class="form-control" value="<%= u.city %>">
                </div>

                <div class="col-md-6 mt-2">
                  <label>Pincode</label>
                  <input type="text" name="pincode" class="form-control" value="<%= u.pincode %>">
                </div>

                <div class="col-md-6 mt-2">
                  <label>Address</label>
                  <textarea name="address" class="form-control" rows="1"><%= u.address %></textarea>
                </div>
              </div>

              <!-- ░░░░░░░░░░ SECTION 4 : FAMILY & BACKGROUND ░░░░░░░░░░ -->
              <div class="section-title">Family & Background</div>

              <div class="row">
                <div class="col-md-6 mt-2">
                  <label>Religion</label>
                  <input type="text" name="religion" class="form-control" value="<%= u.religion %>">
                </div>
                <div class="col-md-6 mt-2">
                  <label>Sub Religion</label>
                  <input type="text" name="sub_religion" class="form-control" value="<%= u.sub_religion %>">
                </div>
              </div>

              <% 
              const familyFields = [
                "caste","blood_group","residency_year","family_income",
                "mother_name","father_name","any_disability","mangalik"
              ];
              %>

              <div class="row">
              <% familyFields.forEach(f => { %>
                <div class="col-md-6 mt-2">
                  <label><%= f.replace(/_/g," ").toUpperCase() %></label>
                  <input type="text" name="<%= f %>" class="form-control" value="<%= u[f] %>">
                </div>
              <% }) %>
              </div>

              <!-- ░░░░░░░░░░ SECTION 5 : PERSONAL DETAILS ░░░░░░░░░░ -->
              <div class="section-title">Personal Details</div>

              <% 
              const personalFields = [
                "about","hobbies","horoscopes","diet","height",
                "skin_tone","brother_count","sister_count"
              ];
              %>

              <div class="row">
              <% personalFields.forEach(f => { %>
                <div class="col-md-6 mt-2">
                  <label><%= f.replace(/_/g," ").toUpperCase() %></label>
                  <input type="text" name="<%= f %>" class="form-control" value="<%= u[f] %>">
                </div>
              <% }) %>
              </div>

              <!-- ░░░░░░░░░░ SECTION 6 : PROFESSIONAL DETAILS ░░░░░░░░░░ -->
              <div class="section-title">Professional Details</div>

              <% 
              const proFields = [
                "marital_status","child","highest_education","organization",
                "course","work_type","company_name","income","profession","status","token"
              ];
              %>

              <div class="row">
              <% proFields.forEach(f => { %>
                <div class="col-md-6 mt-2">
                  <label><%= f.replace(/_/g," ").toUpperCase() %></label>
                  <input type="text" name="<%= f %>" class="form-control" value="<%= u[f] %>">
                </div>
              <% }) %>
              </div>
              </br>
              <div id="responseMsg"></div>

              <button class="btn btn-danger mt-4">Update</button>
              <a href="/users" class="btn btn-secondary mt-4 ml-2">Cancel</a>

            </form>

            <% } else { %>
              <p class="text-danger">User not found</p>
            <% } %>

          </div>
        </div>

      </div>

      <%- include('../partials/_footer') %>
    </div>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/choices.js/public/assets/scripts/choices.min.js"></script>

<script>
// base64 image preview
let profileBase64 = null;
document.getElementById("profileImg").addEventListener("change", e => {
    const file = e.target.files[0];
    const reader = new FileReader();
    reader.onload = () => {
        profileBase64 = reader.result;
        document.getElementById("profilePreview").src = reader.result;
    };
    reader.readAsDataURL(file);
});

// form submit
document.getElementById("editUserForm").addEventListener("submit", async e => {
    e.preventDefault();

    const form = e.target;
    const data = Object.fromEntries(new FormData(form).entries());
    data.img = profileBase64;

    const res = await fetch('/update-profile', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
    });

    const r = await res.json();
document.getElementById("responseMsg").innerHTML =
  `<div class="alert alert-${r.success?'success':'danger'}">${r.msg}</div>`;

// hide alert after 5 seconds
setTimeout(() => {
    document.getElementById("responseMsg").innerHTML = "";
}, 5000);
});
</script>

<script src="/vendors/js/vendor.bundle.base.js"></script>
<script src="/js/off-canvas.js"></script>
<script src="/js/misc.js"></script>
<%- include('../partials/_script') %>
</body>
</html>
