<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>User Registration - Satphere</title>
  <%- include('../partials/_head') %>
  <link rel="stylesheet" href="/vendors/mdi/css/materialdesignicons.min.css">
  <link rel="stylesheet" href="/vendors/ti-icons/css/themify-icons.css">
  <link rel="stylesheet" href="/vendors/font-awesome/css/font-awesome.min.css">
  <link rel="stylesheet" href="/vendors/css/vendor.bundle.base.css">
  <link rel="stylesheet" href="/css/style.css">
 <style>
  .form-control {
    border-radius: 10px;
  }
  .profile-img-box {
    text-align: center;
    padding: 20px;
    border: 1px solid #ddd;
    border-radius: 8px;
    margin-top: 10px;
    background: #f9f9f9;
  }
  .profile-img-box img {
    max-width: 120px;
    min-height: 100px;
    border-radius: 50%;
    margin-bottom: 10px;
    border: 2px solid #f3c5e8;
    padding: 5px;
    background: #fff;
    object-fit: cover;
  }
</style>
</head>
<body>
  <div class="container-scroller">
    <%- include('../partials/_navbar') %>
    <div class="container-fluid page-body-wrapper">
      <%- include('../partials/_sidebar') %>
      <div class="main-panel">
        <div class="content-wrapper">
          <div class="page-header">
            <h3 class="page-title mt-2">Register New User</h3>
          </div>

          <div class="row">
            <div class="col-md-12 grid-margin stretch-card">
              <div class="card">
                <div class="card-body">
                  <h4 class="card-title mb-4">Registration Form</h4>

                  <form id="registrationForm" novalidate>
                    <!-- 🔹 IMAGE UPLOAD -->
					<div class="row mt-2">
					  <div class="col-md-12">
						<label>Profile Image</label>
						<div class="profile-img-box">
						  <img id="imgPreview" src="/images/faces-clipart/profile.png" alt="Profile" class="img-preview">
						  <input type="file" class="form-control mt-2" name="profileImg" id="profileImg" accept="image/*">
						</div>
					  </div>
					</div>

                    <input type="hidden" name="img" id="imgBase64">
<br>
                    <div class="row">
                      <div class="col-md-6">
                        <label>First Name</label>
                        <input type="text" name="first_name" class="form-control" required placeholder="Enter first name">
                      </div>
                      <div class="col-md-6">
                        <label>Last Name</label>
                        <input type="text" name="last_name" class="form-control" required placeholder="Enter last name">
                      </div>
                    </div>

                    <div class="row mt-2">
                      <div class="col-md-6">
                        <label>Gender</label>
                        <select name="gender" class="form-control" required>
                          <option value="">Select Gender</option>
                          <option value="Male">Male</option>
                          <option value="Female">Female</option>
                          <option value="Other">Other</option>
                        </select>
                      </div>
                      <div class="col-md-6">
                        <label>Date of Birth</label>
                        <input type="date" name="dob" class="form-control" required>
                      </div>
                    </div>

                    <div class="row mt-2">
                      <div class="col-md-6">
                        <label>Mobile No</label>
                        <input type="text" name="mobile_no" class="form-control" required placeholder="Enter mobile number">
                      </div>
                      <div class="col-md-6">
                        <label>Email</label>
                        <input type="email" name="email" class="form-control" required placeholder="Enter email address">
                      </div>
                    </div>

                    <div class="row mt-2">
                      <div class="col-md-6">
                        <label>State</label>
                        <input type="text" name="state" class="form-control" placeholder="Enter state">
                      </div>
                      <div class="col-md-6">
                        <label>City</label>
                        <input type="text" name="city" class="form-control" placeholder="Enter city">
                      </div>
                    </div>

                    <div class="row mt-2">
                      <div class="col-md-6">
                        <label>Address</label>
                        <input type="text" name="address" class="form-control" placeholder="Enter address">
                      </div>
                      <div class="col-md-6">
                        <label>Pincode</label>
                        <input type="text" name="pincode" class="form-control" placeholder="Enter pincode">
                      </div>
                    </div>

                    <div class="row mt-2">
                      <div class="col-md-6">
                        <label>Religion</label>
                        <input type="text" name="religion" class="form-control" placeholder="Enter religion">
                      </div>
                      <div class="col-md-6">
                        <label>Sub Religion</label>
                        <input type="text" name="sub_religion" class="form-control" placeholder="Enter sub religion">
                      </div>
                    </div>

                    <div class="row mt-2">
                      <div class="col-md-6">
                        <label>Profession</label>
                        <input type="text" name="profession" class="form-control" placeholder="Enter profession">
                      </div>
                    </div>

                    <div id="responseMsg" class="mt-3"></div>

                    <div class="mt-4">
                      <button type="submit" class="btn btn-danger p-2">Register</button>
                      <a href="/users" class="btn btn-secondary p-2 ml-2">Cancel</a>
                    </div>
                  </form>

                </div>
              </div>
            </div>
          </div>
        </div>
        <%- include('../partials/_footer') %>
      </div>
    </div>
  </div>

<script>
  // 🔹 IMAGE PREVIEW + BASE64
  const imgInput = document.getElementById("profileImg");
  const imgPreview = document.getElementById("imgPreview");
  const imgBase64 = document.getElementById("imgBase64");

  imgInput.addEventListener("change", function () {
    const file = this.files[0];
    if (file) {
      if (!file.type.startsWith("image/")) {
        alert("Please upload a valid image file.");
        this.value = "";
        return;
      }
      if (file.size > 2 * 1024 * 1024) {
        alert("Image must be smaller than 2MB.");
        this.value = "";
        return;
      }

      const reader = new FileReader();
      reader.onload = function (e) {
        imgPreview.src = e.target.result;
        imgBase64.value = e.target.result;
      };
      reader.readAsDataURL(file);
    }
  });

  // 🔹 FORM SUBMIT
  document.getElementById("registrationForm").addEventListener("submit", async function (e) {
    e.preventDefault();
    const msgBox = document.getElementById("responseMsg");

    // Frontend validation
    const form = new FormData(this);
    const mobile = form.get("mobile_no");
    const email = form.get("email");
    const first = form.get("first_name");
    const last = form.get("last_name");

    const nameRegex = /^[A-Za-z\s]+$/;
    const phoneRegex = /^[6-9]\d{9}$/;
    const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

    if (!first || !nameRegex.test(first)) {
      msgBox.innerHTML = `<div class="alert alert-danger">Enter a valid first name (letters only).</div>`;
      return;
    }

    if (!last || !nameRegex.test(last)) {
      msgBox.innerHTML = `<div class="alert alert-danger">Enter a valid last name (letters only).</div>`;
      return;
    }

    if (!phoneRegex.test(mobile)) {
      msgBox.innerHTML = `<div class="alert alert-danger">Enter valid 10-digit mobile number.</div>`;
      return;
    }

    if (!emailRegex.test(email)) {
      msgBox.innerHTML = `<div class="alert alert-danger">Enter valid email address.</div>`;
      return;
    }

    msgBox.innerHTML = `<div class="alert alert-info">Please wait...</div>`;

    const formData = Object.fromEntries(form.entries());

    try {
      const res = await fetch("/api/authregisteradmin", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(formData),
      });

      const data = await res.json();

      if (data.success) {
        msgBox.innerHTML = `<div class="alert alert-success">${data.message}</div>`;
        this.reset();
        imgPreview.src = "/images/faces-clipart/profile.png";
      } else {
        msgBox.innerHTML = `<div class="alert alert-danger">${data.message || "Registration failed."}</div>`;
      }
    } catch (error) {
      msgBox.innerHTML = `<div class="alert alert-danger">Error: ${error.message}</div>`;
    }

    setTimeout(() => (msgBox.innerHTML = ""), 4000);
  });
</script>

  <script src="/vendors/js/vendor.bundle.base.js"></script>
  <script src="/js/off-canvas.js"></script>
  <script src="/js/misc.js"></script>
</body>
</html>
