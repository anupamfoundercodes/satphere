<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%- include('../partials/_head') %>
    <link rel="stylesheet" href="/vendors/mdi/css/materialdesignicons.min.css">
    <link rel="stylesheet" href="/vendors/ti-icons/css/themify-icons.css">
    <link rel="stylesheet" href="/vendors/css/vendor.bundle.base.css">
    <link rel="stylesheet" href="/vendors/font-awesome/css/font-awesome.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
      .editable {
        background-color: #fdfd96;
        cursor: text;
      }
      .editable:focus {
        outline: 2px solid #4caf50;
      }
    </style>
  </head>

  <body>
    <div class="container-scroller">
      <%- include('../partials/_navbar') %>
      <div class="container-fluid page-body-wrapper">
        <%- include('../partials/_sidebar') %>
        <div class="main-panel">
          <div class="content-wrapper">
            <div class="page-header">
              <h3 class="page-title">Subscription Plans</h3>
              <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                  <!--<li class="breadcrumb-item@"><a href="#">Admin</a></li>
                  <li class="breadcrumb-item active" aria-current="page">Plans</li>
                </ol>-->
              </nav>
            </div>

            <!-- Search + Add Button -->
            <div class="row mb-3">
              <div class="col-md-6">
                <input type="text" id="planSearch" class="form-control" placeholder="Search by Plan Name or Days">
              </div>
              <div class="col-md-6 text-end">
              <button class="btn btn-danger" id="addPlanBtn">
                <i class="mdi mdi-plus"></i> Add Plan
              </button>
             </div>
            </div>
            
            <!-- Create Plan Modal -->
            <div class="modal fade" id="createPlanModal" tabindex="-1" aria-hidden="true">
              <div class="modal-dialog modal-md modal-dialog-centered">
                <div class="modal-content" style="border-radius: 10px; overflow: hidden;">
                  <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title"><i class="mdi mdi-plus"></i> Add New Plan</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                  </div>
                  <form id="createPlanForm" class="needs-validation" novalidate>
                    <div class="modal-body">
                      <div class="mb-2">
                        <label class="form-label">Plan Name</label>
                        <input type="text" name="name" class="form-control" required>
                      </div>
                        <div class="mb-2">
                          <label class="form-label">Billing Cycle</label>
                          <select name="billing_cycle" class="form-select" required>
                            <option value="">Select</option>
                            <option value="weekly">Weekly</option>
                            <option value="monthly">Monthly</option>
                          </select>
                        </div>

                      <div class="mb-2">
                        <label class="form-label">Days</label>
                        <input type="number" name="days" class="form-control">
                      </div>
                      <div class="mb-2">
                        <label class="form-label">Price (₹)</label>
                        <input type="number" name="price" class="form-control">
                      </div>
                      <div class="mb-2">
                        <label class="form-label">Offer %</label>
                        <input type="number" name="off" class="form-control">
                      </div>
                      <div class="mb-2">
                        <label class="form-label">Status</label>
                        <select name="status" class="form-select">
                          <option value="1">Active</option>
                          <option value="0">Inactive</option>
                        </select>
                      </div>
                    </div>
                    <div class="modal-footer" style="background:#f8f9fa;">
                      <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                      <button type="submit" class="btn btn-danger">Create Plan</button>
                    </div>
                  </form>
                </div>
              </div>
            </div>


            <!-- Perks Modal -->
            <div class="modal fade" id="perksModal" tabindex="-1" aria-hidden="true">
              <div class="modal-dialog modal-md modal-dialog-centered">
                <div class="modal-content" style="border-radius: 10px; overflow: hidden;">
                  <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">
                      <i class="mdi mdi-gift"></i> Edit Plan Perks
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                  </div>

                  <form id="perksForm" class="needs-validation" novalidate>
                    <div class="modal-body" id="perksContainer"></div>
                    <div class="modal-footer" style="background:#f8f9fa;">
                      <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                      <button type="submit" class="btn btn-dark">Save Changes</button>
                    </div>
                  </form>
                </div>
              </div>
            </div>
            
            <div class="modal fade" id="descriptionModal" tabindex="-1" aria-hidden="true">
              <div class="modal-dialog modal-md modal-dialog-centered">
                <div class="modal-content" style="border-radius: 10px; overflow: hidden;">
                  <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">Edit Plan Description</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                  </div>
                  <div class="modal-body" id="descriptionContainer"></div>
                  <div class="modal-footer" style="background:#f8f9fa;">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-dark" id="descriptionSaveBtn">Save Changes</button>
                  </div>
                </div>
              </div>
            </div>


            <!-- Plans Table -->
            <div class="row">
              <div class="col-lg-12 grid-margin stretch-card">
                <div class="card">
                  <div class="card-body">
                    <h4 class="card-title">Plans Table</h4>
                    <div class="table-responsive">
                      <table class="table table-striped" id="plansTable">
                        <thead>
                          <tr>
                            <th>#</th>
                            <th>Plan Name</th>
                            <th>Billing Cycle</th>
                            <th>Days</th>
                            <th>Price</th>
                            <th>Offers %</th>
                            <th>Perks</th>
                            <th>Description</th>

                            <th>Status</th>
                            <!--<th>Actions</th>-->
                          </tr>
                        </thead>
                        <tbody>
                          <% if (plans && plans.length > 0) { %>
                            <% plans.forEach((plan, index) => { %>
                              <tr>
                                <td><%= index + 1 %></td>
                                <td contenteditable="true" class="editable" data-id="<%= plan.id %>" data-field="name"><%= plan.name %></td>
                                <td contenteditable="true" class="editable" data-id="<%= plan.id %>" data-field="billing_cycle"><%= plan.billing_cycle %></td>
                                <td contenteditable="true" class="editable" data-id="<%= plan.id %>" data-field="days"><%= plan.days %></td>
                                <td contenteditable="true" class="editable" data-id="<%= plan.id %>" data-field="price">₹<%= plan.price %></td>
                                <td contenteditable="true" class="editable" data-id="<%= plan.id %>" data-field="off"><%= plan.off %></td>
                                <td>
                                  <button class="btn btn-sm btn-info view-perks"
                                    data-id="<%= plan.id %>"
                                    data-perks='<%= JSON.stringify(plan.perksObj || {}) %>'>
                                    View
                                  </button>
                                </td>
                                <td contenteditable="true" class="editable" data-id="<%= plan.id %>" data-field="description">
                                  <%= plan.descriptionArr ? plan.descriptionArr.join(', ') : '' %>
                                </td>
                               <!-- <td>
                                 <button class="btn btn-sm btn-warning view-description" 
                                      data-id="<%= plan.id %>" 
                                       data-description='<%= JSON.stringify(plan.descriptionArr || []) %>'>
                                            Edit
                                 </button>
                                 </td>-->
                                
                                <td>
                                  <label class="badge <%= plan.status == '1' ? 'badge-success' : 'badge-danger' %> toggle-status"
                                    style="cursor:pointer;" data-id="<%= plan.id %>" data-status="<%= plan.status %>">
                                    <%= plan.status == '1' ? 'Active' : 'Inactive' %>
                                  </label>
                                </td>
                               <td>
                                  <a href="/plans/delete/<%= plan.id %>" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?')">Delete</a>
                                </td>
                              </tr>
                            <% }) %>
                          <% } else { %>
                            <tr>
                              <td colspan="9" class="text-center text-muted">No plans found</td>
                            </tr>
                          <% } %>
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>
              </div>
            </div>

          </div>
          <%- include('../partials/_footer') %>
        </div>
      </div>
    </div>

    <!-- Scripts -->
    <script src="/vendors/js/vendor.bundle.base.js"></script>
    <script src="/js/off-canvas.js"></script>
    <script src="/js/misc.js"></script>
    <script src="/js/settings.js"></script>
    <script src="/js/todolist.js"></script>
    <%- include('../partials/_script') %>
<script>
      // Search filter
      document.getElementById('planSearch').addEventListener('input', function () {
        const filter = this.value.toLowerCase();
        const rows = document.querySelectorAll('#plansTable tbody tr');
        rows.forEach(row => {
          const name = row.children[1].textContent.toLowerCase();
          const days = row.children[3].textContent.toLowerCase();
          row.style.display = name.includes(filter) || days.includes(filter) ? '' : 'none';
        });
      });
   </script>
   <script>
      
      // Toggle status
      document.querySelectorAll('.toggle-status').forEach(badge => {
        badge.addEventListener('click', function () {
          const planId = this.dataset.id;
          const newStatus = this.dataset.status === '1' ? '0' : '1';

          fetch('/plans/status-toggle', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id: planId, status: newStatus })
          })
          .then(res => res.json())
          .then(data => {
            if (data.success) {
              this.dataset.status = newStatus;
              this.classList.toggle('badge-success');
              this.classList.toggle('badge-danger');
              this.textContent = newStatus === '1' ? 'Active' : 'Inactive';
            } else {
              alert('Failed to update status');
            }
          });
        });
      });
</script>
<script>
  // Perks Modal (replace the old block with this)

// Perks Modal (all perks including Filter-Both now editable)
let currentPlanId = null;

document.querySelectorAll('.view-perks').forEach(btn => {
  btn.addEventListener('click', function () {
    currentPlanId = this.dataset.id;
    const perksData = JSON.parse(this.dataset.perks || '{}');
    const perksContainer = document.getElementById("perksContainer");
    perksContainer.innerHTML = "";

    Object.entries(perksData).forEach(([key, value]) => {
      const formGroup = document.createElement("div");
      formGroup.className = "mb-2";

      const label = document.createElement("label");
      label.className = "form-label fw-bold";
      label.innerText = key;
      formGroup.appendChild(label);

      // All perks now: select + optional custom input
      const row = document.createElement("div");
      row.className = "d-flex gap-2";

      const select = document.createElement("select");
      select.className = "form-select";
      select.style.minWidth = "120px";
      select.name = `perks_select_${escapeKey(key)}`;

      ["", "true", "false"].forEach(v => {
        const opt = document.createElement("option");
        opt.value = v;
        opt.text = v === "" ? "Select" : v;
        select.appendChild(opt);
      });

      // set selection if boolean
      if (value === true) select.value = "true";
      else if (value === false) select.value = "false";
      else select.value = "";

      const input = document.createElement("input");
      input.type = "text";
      input.className = "form-control";
      input.name = `perks_text_${escapeKey(key)}`;
      input.placeholder = "Custom string (optional)";
      if (value !== true && value !== false && value != null) input.value = String(value);

      // Interaction: typing custom clears select, selecting clears custom
      input.addEventListener('input', () => {
        if (input.value.trim() !== "") select.value = "";
      });
      select.addEventListener('change', () => {
        if (select.value === "true" || select.value === "false") {
          input.value = "";
        }
      });

      row.appendChild(select);
      row.appendChild(input);
      formGroup.appendChild(row);
      perksContainer.appendChild(formGroup);
    });

    const perksModal = new bootstrap.Modal(document.getElementById('perksModal'));
    perksModal.show();
  });
});

// Save perks: same as before
document.getElementById('perksForm').addEventListener('submit', function (e) {
  e.preventDefault();
  if (!currentPlanId) return;

  const perks = {};
  document.querySelectorAll('#perksContainer .mb-2').forEach(g => {
    const key = g.querySelector('label')?.innerText?.trim();
    if (!key) return;

    const input = g.querySelector(`input[name="perks_text_${escapeKey(key)}"]`);
    const select = g.querySelector(`select[name="perks_select_${escapeKey(key)}"]`);
    const custom = input ? input.value.trim() : "";

    if (custom !== "") perks[key] = custom;
    else if (select && select.value === "true") perks[key] = true;
    else if (select && select.value === "false") perks[key] = false;
    else perks[key] = "";
  });

  fetch('/plans/update-field', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ id: currentPlanId, field: 'perks', value: JSON.stringify(perks) })
  })
  .then(res => res.json())
  .then(data => {
    if (data.success) {
      bootstrap.Modal.getInstance(document.getElementById('perksModal')).hide();
      location.reload();
    } else {
      alert('Failed to update perks');
    }
  })
  .catch(() => alert('Something went wrong'));
});

function escapeKey(k) {
  return k.replace(/[^a-zA-Z0-9_-]/g, '_');
}

</script>
    <script>
      // Inline edit for table cells
      document.querySelectorAll(".editable").forEach(cell => {
        cell.addEventListener("blur", function () {
          const id = this.dataset.id;
          const field = this.dataset.field;
          let value = this.innerText.trim();

          // agar price hai to ₹ remove kar
          if (field === "price" && value.startsWith("₹")) {
            value = value.replace("₹", "").trim();
          }

          if (value === "") return; // blank mat bhejna

          fetch("/plans/update-field", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ id, field, value })
          })
          .then(res => res.json())
          .then(data => {
            if (!data.success) {
              alert("Failed to update plan!");
            }
          })
          .catch(() => alert("Something went wrong"));
        });
      });
    </script>
    
    <script>
  // Open Create Plan Modal
  document.getElementById('addPlanBtn').addEventListener('click', () => {
    const modal = new bootstrap.Modal(document.getElementById('createPlanModal'));
    modal.show();
  });

  // Submit Create Plan Form
  document.getElementById('createPlanForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const data = {
      name: form.name.value.trim(),
      billing_cycle: form.billing_cycle.value.trim(),
      days: form.days.value,
      price: form.price.value,
      off: form.off.value,
      status: form.status.value
    };

    try {
      const res = await fetch('/plans/add', {  // your existing route
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      const result = await res.json();
      if (result.success) {
        bootstrap.Modal.getInstance(document.getElementById('createPlanModal')).hide();
        location.reload(); // reload to show new plan in table
      } else {
        alert(result.message || 'Failed to create plan');
      }
    } catch (err) {
      alert('Something went wrong');
      console.error(err);
    }
  });
</script>

  </body>
</html>
