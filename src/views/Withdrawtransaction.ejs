    <!-- Search Filter Script -->
<script>
  document.querySelectorAll('.toggle-status-user').forEach(button => {
    button.addEventListener('click', async function () {
      const userId = this.getAttribute('data-user-id');
      const currentStatus = this.textContent.trim().toLowerCase();
      const newStatus = currentStatus === 'pending' ? 'confirm' : 'pending';

      try {
        const res = await fetch(`/transactions/${userId}/status`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status: newStatus })
        });

        if (res.ok) {
          this.textContent = newStatus.charAt(0).toUpperCase() + newStatus.slice(1);
          this.classList.toggle('btn-success');
          this.classList.toggle('btn-danger');
        } else {
          alert('Failed to update status');
        }
      } catch (err) {
        console.error(err);
        alert('An error occurred while updating status');
      }
    });
  });
</script>

<script>
  document.getElementById("userSearch").addEventListener("input", function () {
    const searchTerm = this.value.toLowerCase();
    const rows = document.querySelectorAll("#usersTable tbody tr");

    rows.forEach(row => {
      const name = row.cells[1]?.textContent.toLowerCase() || '';
      const phone = row.cells[2]?.textContent.toLowerCase() || '';
      const title = row.cells[3]?.textContent.toLowerCase() || '';
      const vendorId = row.cells[5]?.textContent.toLowerCase() || '';
      const cardNo = row.cells[6]?.textContent.toLowerCase() || '';
       const orderid = row.cells[7]?.textContent.toLowerCase() || '';

      if (
        name.includes(searchTerm) ||
        phone.includes(searchTerm) ||
        title.includes(searchTerm) ||
        vendorId.includes(searchTerm) ||
        cardNo.includes(searchTerm)  ||
        orderid.includes(searchTerm)
      ) {
        row.style.display = "";
      } else {
        row.style.display = "none";
      }
    });
  });
</script>


<script>
document.querySelectorAll('.delete-user').forEach(button => {
  button.addEventListener('click', async function () {
    const userId = this.getAttribute('data-user-id');
    const row = this.closest('tr');

    if (!confirm('Are you sure you want to delete this user?')) return;

    try {
      const res = await fetch(`/deleteprofile/${userId}`, {
        method: 'GET' // or 'DELETE' if your API supports it
      });

      const data = await res.json();
     if (data.success) {
  row.remove();

  const container = document.getElementById('successMsgContainer');
  if (container) {
    container.innerHTML = `
      <div class="alert alert-success alert-dismissible fade show" role="alert">
        ${data.message}
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    `;

    // Auto-hide after 3 sec
    setTimeout(() => {
      container.innerHTML = '';
    }, 3000);
  }
}
 else {
        alert(data.message || 'Failed to delete user');
      }
    } catch (err) {
      console.error(err);
      alert('Error while deleting user');
    }
  });
});
</script>

//action btn-close
<script>
  // SUCCESS BTN
  document.querySelectorAll('.mark-success').forEach(btn => {
    btn.addEventListener('click', async function () {
      const id = this.getAttribute('data-user-id');
      if (!confirm('Are you sure you want to mark this transaction as SUCCESS?')) return;

      try {
        const res = await fetch(`/success/${id}`, { method: "POST" });
        const data = await res.json();

        if (data.success) {
          alert("✅ " + data.msg);
          location.reload(); // Refresh table
        } else {
          alert("❌ " + data.msg);
        }
      } catch (err) {
        console.error(err);
        alert("Error processing success request");
      }
    });
  });

  // FAILED BTN
  document.querySelectorAll('.mark-failed').forEach(btn => {
    btn.addEventListener('click', async function () {
      const id = this.getAttribute('data-user-id');
      if (!confirm('Are you sure you want to mark this transaction as FAILED?')) return;

      try {
        const res = await fetch(`/failed/${id}`, { method: "POST" });
        const data = await res.json();

        if (data.success) {
          alert("✅ Transaction marked as FAILED");
          location.reload();
        } else {
          alert("❌ " + data.msg);
        }
      } catch (err) {
        console.error(err);
        alert("Error marking transaction failed");
      }
    });
  });
</script>




