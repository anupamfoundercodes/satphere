<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <%- include('../partials/_head') %> 
    <link rel="stylesheet" href="vendors/mdi/css/materialdesignicons.min.css">
    <link rel="stylesheet" href="vendors/ti-icons/css/themify-icons.css">
    <link rel="stylesheet" href="vendors/css/vendor.bundle.base.css">
    <link rel="stylesheet" href="vendors/font-awesome/css/font-awesome.min.css">
    <link rel="stylesheet" href="css/style.css">
  </head>
  <body>
    <div class="container-scroller">
      <%- include('../partials/_navbar') %> 
      <div class="container-fluid page-body-wrapper">
        <%- include('../partials/_sidebar') %> 
        <div class="main-panel">
          <div class="content-wrapper">

            <div class="page-header d-flex justify-content-between align-items-center flex-wrap">
              <h3 class="page-title mb-2 mb-md-0">Friend History</h3>
            </div>

            <div class="row mb-3">
              <div class="col-md-6">
               <form method="GET" action="/friends" class="mb-3">
  <input type="text" name="search" value="<%= search %>" class="form-control" placeholder="Search by User, Friend, Type, Status">
</form>

              </div>
            </div>

            <div class="row">
              <div class="col-lg-12 grid-margin stretch-card">
                <div class="card">
                  <div class="card-body">
                    <h4 class="card-title">Friends Table</h4>
                    <div class="table-responsive">
                      <table class="table table-striped" id="friendsTable">
                        <thead>
                          <tr>
                            <th>#</th>
                            <th>User</th>
                            <th>Friend</th>
                            <th>Type</th>

                            <th>Created At</th>
                            <th>Updated At</th>
                            <th>Status</th>                            
                            <th>Actions</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% if (friends && friends.length > 0) { %>
                            <% friends.forEach((f, index) => { %>
                              <tr>
                                <td><%= index + 1 %></td>
                                <td><%= f.user_name || f.user_id %></td>
                                <td><%= f.friend_name || f.friend_id %></td>
                                <td>
									  <% if (f.type == 0) { %>
										<span class="badge bg-danger">Request</span>
									  <% } else if (f.type == 1) { %>
										<span class="badge bg-success">Accept</span>
									  <% } else if (f.type == 2) { %>
										<span class="badge bg-danger">Reject</span>
									  <% } else if (f.type == 3) { %>
										<span class="badge bg-dark">Block</span>
									  <% } else { %>
										<span class="badge bg-light text-dark">Shortlist</span>
									  <% } %>
                                </td>

                                <td><%= f.created_at ? new Date(f.created_at).toLocaleString() : '-' %></td>
                                <td><%= f.updated_at ? new Date(f.updated_at).toLocaleString() : '-' %></td>
                                 <td>
                                  <button class="btn btn-sm toggle-status <%= f.status === 'active' ? 'btn-success' : 'btn-danger' %>" 
                                    data-id="<%= f.id %>">
                                    <%= f.status %>
                                  </button>
                                </td>
                                <td>
                                  <button class="btn btn-sm btn-danger delete-friend" data-id="<%= f.id %>">Delete</button>
                                </td>
                              </tr>
                            <% }) %>
                          <% } else { %>
                            <tr>
                              <td colspan="8" class="text-center text-muted">No friends found</td>
                            </tr>
                          <% } %>
                        </tbody>
                      </table>
                                              <!-- Pagination Start -->
							<div class="row">
							  <div class="col-md-12 d-flex justify-content-center mt-3">
								<nav aria-label="Page navigation">
								  <ul class="pagination pagination-sm flex-wrap">

									<% 
									  const maxVisiblePages = 5;
									  const startPage = Math.max(1, currentPage - Math.floor(maxVisiblePages / 2));
									  const endPage = Math.min(totalPages, startPage + maxVisiblePages - 1);

									  const createPageLink = (i) => {
										const url = '/friends?page=' + i + (search ? '&search=' + encodeURIComponent(search) : '');
										return url;
									  };
									%>

									<!-- Prev -->
									<li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
									  <a class="page-link"
										 href="<%= currentPage === 1 ? '#' : createPageLink(currentPage - 1) %>"
										 style="border:1px solid #FFE8EC; border-radius:6px; transition:all 0.3s ease;">Prev</a>
									</li>

									<!-- First -->
									<% if (startPage > 1) { %>
									  <li class="page-item">
										<a class="page-link" href="<%= createPageLink(1) %>"
										   style="border:1px solid #FFE8EC; border-radius:6px; transition:all 0.3s ease;">1</a>
									  </li>
									  <% if (startPage > 2) { %>
										<li class="page-item disabled">
										  <a class="page-link" style="border:1px solid #f3d6dc; border-radius:6px;">...</a>
										</li>
									  <% } %>
									<% } %>

									<!-- Pages -->
									<% for (let i = startPage; i <= endPage; i++) { %>
									  <li class="page-item <%= i === currentPage ? 'active disabled' : '' %>">
										<a class="page-link"
										   href="<%= i === currentPage ? '#' : createPageLink(i) %>"
										   style="border:1px solid #FFE8EC; border-radius:6px; transition:all 0.3s ease;"><%= i %></a>
									  </li>
									<% } %>

									<!-- Last -->
									<% if (endPage < totalPages) { %>
									  <% if (endPage < totalPages - 1) { %>
										<li class="page-item disabled">
										  <a class="page-link" style="border:1px solid #f3d6dc; border-radius:6px;">...</a>
										</li>
									  <% } %>
									  <li class="page-item">
										<a class="page-link" href="<%= createPageLink(totalPages) %>"
										   style="border:1px solid #FFE8EC; border-radius:6px; transition:all 0.3s ease;"><%= totalPages %></a>
									  </li>
									<% } %>

									<!-- Next -->
									<li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
									  <a class="page-link"
										 href="<%= currentPage === totalPages ? '#' : createPageLink(currentPage + 1) %>"
										 style="border:1px solid #FFE8EC; border-radius:6px; transition:all 0.3s ease;">Next</a>
									</li>
								  </ul>
								</nav>
							  </div>
							</div>


                        <!-- Pagination End -->

                      <p id="friendCount" class="mt-3 text-muted">Showing <%= friends.length %> records</p>
                    </div>
                  </div>
                </div>
              </div>
              <div id="successMsgContainer"></div>
            </div>

          </div>
          <%- include('../partials/_footer') %> 
        </div>
      </div>
    </div>

    <script src="vendors/js/vendor.bundle.base.js"></script>
    <script src="js/off-canvas.js"></script>
    <script src="js/misc.js"></script>
    <script src="js/settings.js"></script>
    <script src="js/todolist.js"></script>
    <script src="js/jquery.cookie.js"></script>
    <%- include('../partials/_script') %> 

    <!-- Search Filter -->
    <script>
      document.getElementById("friendSearch").addEventListener("input", function () {
        const searchTerm = this.value.toLowerCase();
        const rows = document.querySelectorAll("#friendsTable tbody tr");

        rows.forEach(row => {
          const user = row.cells[1]?.textContent.toLowerCase() || '';
          const friend = row.cells[2]?.textContent.toLowerCase() || '';
          const type = row.cells[3]?.textContent.toLowerCase() || '';
          const status = row.cells[5]?.textContent.toLowerCase() || '';

          if (
            user.includes(searchTerm) ||
            friend.includes(searchTerm) ||
            type.includes(searchTerm) ||
            status.includes(searchTerm)
          ) {
            row.style.display = "";
          } else {
            row.style.display = "none";
          }
        });
      });
    </script>

    <!-- Toggle + Delete -->
    <script>
      // Toggle status
      document.querySelectorAll('.toggle-status').forEach(btn => {
        btn.addEventListener('click', async function() {
          const id = this.getAttribute('data-id');
          const current = this.textContent.trim().toLowerCase();
          const newStatus = current === 'active' ? 'inactive' : 'active';

          try {
            const res = await fetch(`/friends/${id}/status`, {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ status: newStatus })
            });
            const data = await res.json();
            if(data.success){
              this.textContent = newStatus;
              this.className = 'btn btn-sm toggle-status ' + 
                (newStatus==='active' ? 'btn-success' : 'btn-danger');
            } else alert(data.msg);
          } catch(err){ console.error(err); alert("Error updating status"); }
        });
      });

      // Delete
      document.querySelectorAll('.delete-friend').forEach(btn => {
        btn.addEventListener('click', async function() {
          const id = this.getAttribute('data-id');
          const row = this.closest('tr');
          if(!confirm('Delete this friend record permanently?')) return;

          try {
            const res = await fetch(`/friends/${id}`, { method: 'DELETE' });
            const data = await res.json();
            if(data.success){
              row.remove();
              const count = document.getElementById('friendCount');
              const current = parseInt(count.textContent.replace(/\D/g,'')) - 1;
              count.textContent = `Showing ${current} records`;
            } else alert(data.msg);
          } catch(err){ console.error(err); alert("Error deleting record"); }
        });
      });
    </script>
  </body>
</html>
