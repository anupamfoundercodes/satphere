<!DOCTYPE html>
<html>
<head>
  <title>Height List</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
</head>
<body class="p-4">
  <div class="container">
    <h2 class="text-center">Height Master</h2>
    <table class="table table-striped table-bordered mt-4">
      <thead class="table-light">
        <tr>
          <th>ID</th>
          <th>Height (cm)</th>
          <th>Height (feet)</th>
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        <% heights.forEach(height => { %>
          <tr>
            <td><%= height.id %></td>
            <td><%= height.height_cm %></td>
            <td><%= height.height_text %></td>
            <td><%= height.status %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</body>
</html>

