<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <%- include('../partials/_head') %>
    <link rel="stylesheet" href="vendors/mdi/css/materialdesignicons.min.css" />
    <link rel="stylesheet" href="vendors/ti-icons/css/themify-icons.css" />
    <link rel="stylesheet" href="vendors/css/vendor.bundle.base.css" />
    <link rel="stylesheet" href="vendors/font-awesome/css/font-awesome.min.css" />
    <link rel="stylesheet" href="css/style.css" />
  </head>
  <body>
    <div class="container-scroller">
      <%- include('../partials/_navbar') %>
      <div class="container-fluid page-body-wrapper">
        <%- include('../partials/_sidebar') %>
        <div class="main-panel">
          <div class="content-wrapper">
            <div class="page-header d-flex justify-content-between align-items-center flex-wrap">
              <h3 class="page-title mb-2 mb-md-0">User Videos</h3>
            </div>

            <div class="row mb-3">
              <div class="col-md-6">
                <form method="GET" action="/user_videos" class="d-flex">
                  <input type="text" name="search" value="<%= search %>" class="form-control me-2" placeholder="Search by Username, Name or Caption" />
                  <button class="btn btn-outline-primary" type="submit">Search</button>
                </form>
              </div>
            </div>

            <div class="row">
              <div class="col-lg-12 grid-margin stretch-card">
                <div class="card">
                  <div class="card-body">
                    <h4 class="card-title">User Videos Table</h4>
                    <div class="table-responsive">
                      <table class="table table-striped" id="videosTable">
                        <thead>
                          <tr>
                            <th>#</th>
                            <th>User</th>
                            <th>Video</th>
                            <th>Caption</th>
                            <th>Likes</th>
                            <th>Comments</th>
                            <th>Comment Status</th>
                            <th>Share Status</th>
                            <th>Like Status</th>
                            <th>Status</th>
                            <th>Actions</th>
                          </tr>
                        </thead>
                        <tbody>
                          <% if (videos && videos.length > 0) { %>
                            <% videos.forEach((video, index) => { %>
                              <tr>
                                <td><%= index + 1 %></td>
                                <td>
                                  <img src="<%= video.profile_pic || '/images/faces-clipart/profile.png' %>" class="profile-img-box" />
                                  <div><%= video.username || 'N/A' %></div>
                                </td>
                                <td>
                                  <video width="120" controls>
                                    <source src="<%= video.video %>" type="video/mp4" />
                                  </video>
                                </td>
                                <td><%= video.caption || '-' %></td>
                                <td><%= video.like_count %></td>
                                <td><%= video.comment_count %></td>
                                <td><%= video.comment_status %></td>
                                <td><%= video.share_status %></td>
                                <td><%= video.like_status %></td>
                                <td>
                                  <button
                                    class="btn btn-sm toggle-status <%= video.status === 'ACTIVE' ? 'btn-success' : 'btn-danger' %>"
                                    data-video-id="<%= video.id %>"
                                  >
                                    <%= video.status === 'ACTIVE' ? 'Active' : 'Inactive' %>
                                  </button>
                                </td>
                                <td>
                                  <button class="btn btn-danger btn-sm delete-video" data-video-id="<%= video.id %>">Delete</button>
                                </td>
                              </tr>
                            <% }) %>
                          <% } else { %>
                            <tr>
                              <td colspan="11" class="text-center text-muted">No videos found</td>
                            </tr>
                          <% } %>
                        </tbody>
                      </table>

                      <!-- Pagination -->
                      <div class="d-flex justify-content-center mt-3">
                        <nav>
                          <ul class="pagination">
                            <% if (currentPage > 1) { %>
                            <li class="page-item">
                              <a class="page-link" href="/user_videos?page=<%= currentPage - 1 %>&search=<%= search %>">Previous</a>
                            </li>
                            <% } %>

                            <% for (let i = 1; i <= totalPages; i++) { %>
                            <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                              <a class="page-link" href="/user_videos?page=<%= i %>&search=<%= search %>"><%= i %></a>
                            </li>
                            <% } %>

                            <% if (currentPage < totalPages) { %>
                            <li class="page-item">
                              <a class="page-link" href="/user_videos?page=<%= currentPage + 1 %>&search=<%= search %>">Next</a>
                            </li>
                            <% } %>
                          </ul>
                        </nav>
                      </div>

                      <div id="successMsgContainer"></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <%- include('../partials/_footer') %>
        </div>
      </div>
    </div>

    <!-- JS -->
    <script src="vendors/js/vendor.bundle.base.js"></script>
    <script src="js/off-canvas.js"></script>
    <script src="js/misc.js"></script>
    <script src="js/settings.js"></script>
    <script src="js/todolist.js"></script>
    <script src="js/jquery.cookie.js"></script>
    <%- include('../partials/_script') %>

    <script>
    // Toggle video status
    document.querySelectorAll(".toggle-status").forEach((button) => {
      button.addEventListener("click", async function () {
        const videoId = this.getAttribute("data-video-id");
        const currentStatus = this.textContent.trim().toUpperCase();
        const newStatus = currentStatus === "ACTIVE" ? "INACTIVE" : "ACTIVE";

        try {
          const res = await fetch(`/user_videos/${videoId}/status`, {
            method: "PATCH",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ status: newStatus }),
          });

          const data = await res.json();

          if (data.success) {
            this.textContent = newStatus === "ACTIVE" ? "Active" : "Inactive";
            this.classList.remove("btn-success", "btn-danger");
            this.classList.add(newStatus === "ACTIVE" ? "btn-success" : "btn-danger");
          } else {
            alert(data.message || "Failed to update status");
          }
        } catch (err) {
          console.error("❌ Frontend error:", err);
          alert("Error updating status");
        }
      });
    });

    // Delete video
    document.querySelectorAll(".delete-video").forEach((button) => {
      button.addEventListener("click", async function () {
        const videoId = this.getAttribute("data-video-id");
        const row = this.closest("tr");

        if (!confirm("Are you sure you want to delete this video?")) return;

        try {
          const res = await fetch(`/deletevideo/${videoId}`, { method: "GET" });
          const data = await res.json();

          if (data.success) {
            row.remove();
            const container = document.getElementById("successMsgContainer");
            if (container) {
              container.innerHTML = `
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                  ${data.message}
                  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
              `;
              setTimeout(() => {
                container.innerHTML = '';
              }, 3000);
            }
          } else {
            alert(data.message || "Failed to delete video");
          }
        } catch (err) {
          console.error(err);
          alert("Error while deleting video");
        }
      });
    });
    </script>
  </body>
</html>
