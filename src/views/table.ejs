<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <%- include('../partials/_head') %>

  <link rel="stylesheet" href="/vendors/mdi/css/materialdesignicons.min.css">
  <link rel="stylesheet" href="/vendors/ti-icons/css/themify-icons.css">
  <link rel="stylesheet" href="/vendors/css/vendor.bundle.base.css">
  <link rel="stylesheet" href="/vendors/font-awesome/css/font-awesome.min.css">
  <link rel="stylesheet" href="/css/style.css">

  <style>
    .editable { background-color:#fff9c4; cursor:text; min-width:120px; }
    .editable:focus { outline:2px solid #4caf50; }
    .badge-success{background:#28a745;color:#fff;}
    .badge-danger{background:#dc3545;color:#fff;}
    .table-title{display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;}
    .small-muted{font-size:0.9rem;color:#6c757d;}
    #tableContainer { max-height: 60vh; overflow-y: auto; }
  </style>
</head>

<body>
<div class="container-scroller">
  <%- include('../partials/_navbar') %>
  <div class="container-fluid page-body-wrapper">
    <%- include('../partials/_sidebar') %>

    <div class="main-panel">
      <div class="content-wrapper">
        <h3 class="page-title">Master Data Tables</h3>

        <!-- TABLE LIST (View buttons) -->
        <div class="card mb-4">
          <div class="card-body">
            <h4 class="text-danger">Available Tables</h4>
            <div class="table-responsive mt-3">
              <table class="table  table-striped">
                <thead>
                  <tr>
                    <th>SR No</th>
                    <th>Table Name</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody>
                <% if (tables && Object.keys(tables).length > 0) { 
                    let i = 1;
                    Object.keys(tables).forEach(tbl => { %>
                      <tr>
                        <td><%= i++ %></td>
                        <td><%= tables[tbl] %></td>
                        <td>
                          <button class="btn btn-sm btn-info viewTableBtn" data-table="<%= tbl %>">View</button>
                        </td>
                      </tr>
                <% }) } else { %>
                  <tr><td colspan="3" class="text-center text-danger">No tables found.</td></tr>
                <% } %>
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- Search + Add Row -->
        <div class="row mb-3">
          <div class="col-md-4">
            <input type="text" id="searchInput" class="form-control" placeholder="Search...">
          </div>
          <div class="col-md-4"></div>
          <div class="col-md-4 text-end">
            <button class="btn btn-danger" id="addBtn">Add New</button>
          </div>
        </div>

        <!-- DYNAMIC TABLE -->
        <div id="tableContainer"></div>

      </div>
      <%- include('../partials/_footer') %>
    </div>
  </div>
</div>

<!-- ADD MODAL -->
<div class="modal fade" id="addModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content border-danger">
      <div class="modal-header bg-danger text-white">
        <h5 class="modal-title">Add New Record</h5>
        <button class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input id="addInput" class="form-control" placeholder="Enter value">
        <div class="form-text small-muted mt-2">This will be added to the main column of selected table.</div>
      </div>
      <div class="modal-footer">
        <button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button class="btn btn-danger" id="saveAddBtn">Save</button>
      </div>
    </div>
  </div>
</div>

<!-- JS -->
<script src="/vendors/js/vendor.bundle.base.js"></script>
<script src="/js/off-canvas.js"></script>
<script src="/js/misc.js"></script>
<script src="/js/settings.js"></script>
<script src="/js/todolist.js"></script>
<%- include('../partials/_script') %>

<script>
let currentTable = "";
let currentRows = [];
let currentColumns = [];

document.addEventListener("DOMContentLoaded", () => {

  // VIEW BUTTON CLICK
  document.querySelectorAll(".viewTableBtn").forEach(btn => {
    btn.addEventListener("click", function () {
      currentTable = this.dataset.table;
      loadTable(currentTable);
    });
  });

  // SEARCH
  document.getElementById("searchInput")?.addEventListener("input", function () {
    renderTable(currentTable, currentRows, this.value.trim().toLowerCase());
  });

  // ADD MODAL
  document.getElementById("addBtn").addEventListener("click", () => {
    if (!currentTable) return alert("Please select a table using View button.");
    document.getElementById("addInput").value = "";
    new bootstrap.Modal(document.getElementById("addModal")).show();
  });

  // SAVE NEW RECORD
  document.getElementById("saveAddBtn")?.addEventListener("click", () => {
    const value = document.getElementById("addInput").value.trim();
    if (!value) return alert("Enter a value");

    fetch("/add-record", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ table: currentTable, fieldValue: value })
    })
    .then(r => r.json())
    .then(resp => {
      if (!resp.success) return alert(resp.message || "Failed to add");
      bootstrap.Modal.getInstance(document.getElementById("addModal")).hide();
      loadTable(currentTable);
    });
  });

});

// LOAD TABLE DATA
function loadTable(tbl) {
  document.getElementById("tableContainer").innerHTML =
    `<div class="text-center py-4">Loading...</div>`;

  fetch("/get-table-data/" + encodeURIComponent(tbl))
    .then(r => r.json())
    .then(data => {
      if (!data.success) {
        document.getElementById("tableContainer").innerHTML =
          `<div class="text-danger">Failed to load table</div>`;
        return;
      }

      currentRows = data.rows || [];
      currentColumns = currentRows.length ? Object.keys(currentRows[0]) : [];
      renderTable(tbl, currentRows);
    });
}

function renderTable(tbl, rows, filter = "") {
  let filtered = rows;

  if (filter) {
    filtered = rows.filter(r =>
      Object.values(r).some(v =>
        String(v || "").toLowerCase().includes(filter)
      )
    );
  }

  let html = `
    <div class="card">
    <div class="card-body">
      <div class="table-title">
        <h4 class="card-title mb-0">${tbl.toUpperCase()}</h4>
        <div class="small-muted">Rows: ${filtered.length}</div>
      </div>
      <div class="table-responsive mt-3">
      <table class="table table-striped table-hover">
      <thead><tr><th>#</th>
  `;

  currentColumns.forEach(col => {
    if (col !== "id") html += `<th>${col}</th>`;
  });

  html += `<th>Actions</th></tr></thead><tbody>`;

  filtered.forEach((row, index) => {
    html += `<tr data-id="${row.id}"><td>${index + 1}</td>`;

    currentColumns.forEach(col => {
      const val = row[col] ?? "";

      if (col === "id") return;

      if (col === "status") {
        html += `<td><button class="btn btn-sm ${val=="active"?"btn-success":"btn-danger"} statusBtn">${val}</button></td>`;
      } else {
        html += `<td contenteditable='true' class='editable' data-field="${col}">${val}</td>`;
      }
    });

    html += `
      <td>
        <button class="btn btn-sm btn-info saveRowBtn">Save</button>
        <button class="btn btn-sm btn-danger deleteRowBtn">Delete</button>
      </td>
    </tr>`;
  });

  html += `</tbody></table></div></div></div>`;
  document.getElementById("tableContainer").innerHTML = html;

  // Save button listener
  document.querySelectorAll(".saveRowBtn").forEach(btn => btn.addEventListener("click", saveRow));

  // Delete button listener
  document.querySelectorAll(".deleteRowBtn").forEach(btn => {
    btn.addEventListener("click", function () {
      const tr = this.closest("tr");
      const id = tr.dataset.id;
      if (!confirm("Are you sure to delete this row?")) return;

      fetch("/delete-record", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ table: currentTable, id })
      })
      .then(r => r.json())
      .then(resp => {
        if (resp.success) loadTable(currentTable);
        else alert(resp.message || "Failed to delete");
      })
      .catch(() => alert("Failed to delete"));
    });
  });

  // Toggle status listener (har table render ke baad)
  document.querySelectorAll(".statusBtn").forEach(btn => {
    btn.addEventListener("click", function () {
      const tr = this.closest("tr");
      const id = tr.dataset.id;
      const currentStatus = this.innerText.trim();
      const newStatus = currentStatus === "active" ? "inactive" : "active";

      fetch("/toggle-status", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ table: currentTable, id, status: newStatus })
      })
      .then(r => r.json())
      .then(resp => {
        if (resp.success) loadTable(currentTable);
        else alert(resp.message || "Failed to update status");
      })
      .catch(() => alert("Failed to update status"));
    });
  });
}


// SAVE ROW
function saveRow(e) {
  const tr = e.target.closest("tr");
  const id = tr.dataset.id;

  const data = {};
  tr.querySelectorAll("[data-field]").forEach(td => {
    data[td.dataset.field] = td.innerText.trim();
  });

  fetch("/update-record", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ table: currentTable, id, data })
  })
  .then(r => r.json())
  .then(resp => {
    alert(resp.message || "Updated");
    loadTable(currentTable);
  });
}

</script>

</body>
</html>
