<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Banner Management</title>
  <%- include('../partials/_head') %>
  <link rel="stylesheet" href="/vendors/css/vendor.bundle.base.css" />
  <link rel="stylesheet" href="/css/style.css" />
  <!-- Add all icon libraries -->
<link rel="stylesheet" href="/vendors/mdi/css/materialdesignicons.min.css">
<link rel="stylesheet" href="/vendors/ti-icons/css/themify-icons.css">
<link rel="stylesheet" href="/vendors/font-awesome/css/font-awesome.min.css">
  <style>
    .banner-container {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 30px;
    }
    .banner-card {
      width: 100%;
      max-width: 300px;
      border: 1px solid #ccc;
      border-radius: 8px;
      padding: 10px;
      text-align: center;
      position: relative;
      background: #fff;
      box-shadow: 0 2px 6px rgba(0,0,0,0.05);
    }
    .banner-card img {
      width: 100%;
      height: 180px;
      object-fit: cover;
      border-radius: 5px;
    }
    .edit-btn .status-btn{
      margin-top: 10px;
    }
    #addBannerModal .modal-body input[type="file"] {
      display: block;
      margin-bottom: 10px;
    }
    .top-action-bar {
      display: flex;
      justify-content: flex-end;
      margin-bottom: 20px;
    }
    .banner-card .btn-sm {
      height: 32px;
      display: flex;
      align-items: center;
    }
    <!--scroll hiden-->
    html, body {
  overflow: hidden; /* Browser ka scroll hide */
  height: 100%;
}

.container-scroller {
  height: 100%;
  overflow-y: auto; /* Sirf inner container scrollable */
}

  </style>
</head>
<body>
  <div class="container-scroller">
    <%- include('../partials/_navbar') %>
    <div class="container-fluid page-body-wrapper">
      <%- include('../partials/_sidebar') %>
      <div class="main-panel">
        <div class="content-wrapper">
          <div class="page-header d-flex justify-content-between align-items-center">
            <h3 class="page-title">Banner Management</h3>
            <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#addBannerModal">Add Banner</button>
          </div>

          <% if (banners && banners.length > 0) { %>
            <div class="banner-container">
              <% banners.forEach((banner, index) => { %>
                <div class="banner-card">
                  <img src="<%= banner.img_url %>" alt="Banner <%= index + 1 %>">
                  <p class="mt-2 small text-muted">Link: <%= banner.action_link || 'N/A' %></p>
                  <div class="d-flex justify-content-center gap-2">
                    <button class="btn btn-sm btn-danger edit-btn" onclick="openEditModal('<%= banner.id %>', '<%= banner.img_url %>', '<%= banner.action_link %>')">Edit</button>
  <form method="POST" action="/toggle-banner-status" class="d-inline">
  <input type="hidden" name="id" value="<%= banner.id %>">
  <input type="hidden" name="status" value="<%= banner.status === 'active' ? 'inactive' : 'active' %>">
  <button type="submit" class="btn btn-sm <%= banner.status === 'active' ? 'btn-outline-success' : 'btn-outline-secondary' %> ml-2">
    <%= banner.status === 'active' ? 'Active' : 'Inactive' %>
  </button>
</form>
                  </div>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <p>No banners yet. Click above to add one.</p>
          <% } %>

        </div>

        <%- include('../partials/_footer') %>
      </div>
    </div>
  </div>

  <!-- Add/Edit Banner Modal -->
  <div class="modal fade" id="addBannerModal" tabindex="-1" role="dialog" aria-labelledby="bannerModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
      <form id="bannerForm" method="POST" action="/add-banner" enctype="multipart/form-data">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="bannerModalLabel">Add / Edit Banner</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>
          <div class="modal-body">
            <input type="hidden" name="id" id="bannerId">
            <label for="bannerImage">Banner Image</label>
            <input type="file" name="bannerImage" id="bannerImage" accept="image/*">
            <img id="previewImage" src="" class="img-fluid mt-2" style="max-height: 150px; display: none;">

            <label for="actionLink" class="mt-3">Action Link</label>
            <input type="text" class="form-control" name="actionLink" id="actionLink" placeholder="https://example.com">
          </div>
          <div class="modal-footer">
            <button type="submit" class="btn btn-success">Save</button>
            <button type="button" class="btn btn-danger" onclick="deleteBanner()" data-bs-dismiss="modal">Delete</button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <!-- Scripts -->
  <script src="/vendors/js/vendor.bundle.base.js"></script>
  <script src="/js/off-canvas.js"></script>
  <script src="/js/misc.js"></script>
  <script>
    function openEditModal(id, imgUrl, actionLink) {
      document.getElementById('bannerId').value = id;
      document.getElementById('actionLink').value = actionLink;
      document.getElementById('previewImage').src = imgUrl;
      document.getElementById('previewImage').style.display = 'block';
      document.getElementById('bannerImage').value = '';
      const modal = new bootstrap.Modal(document.getElementById('addBannerModal'));
      modal.show();
    }

    document.getElementById('bannerImage').addEventListener('change', function(event) {
      const file = event.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = function(e) {
          const preview = document.getElementById('previewImage');
          preview.src = e.target.result;
          preview.style.display = 'block';
        };
        reader.readAsDataURL(file);
      }
    });

    function toggleStatus(bannerId) {
      const btn = document.getElementById(`status-btn-${bannerId}`);
      const current = btn.innerText;
      if (current === 'Inactive') {
        btn.innerText = 'Active';
        btn.classList.remove('btn-outline-secondary');
        btn.classList.add('btn-outline-success');
      } else {
        btn.innerText = 'Inactive';
        btn.classList.remove('btn-outline-success');
        btn.classList.add('btn-outline-secondary');
      }
      // TODO: Make API call to update status in backend
    }
    
  </script>
  //delete banner
  <script>
  function deleteBanner() {
    const bannerId = document.getElementById('bannerId').value;
    if (!bannerId) return;

    if (confirm('Are you sure you want to delete this banner?')) {
      fetch('/delete-banner', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({ id: bannerId })
      })
      .then(response => response.json())
      .then(data => {
        if (data.success) {
          alert('Banner deleted successfully');
          location.reload();
        } else {
          alert('Failed to delete banner');
        }
      })
      .catch(err => {
        console.error('Error:', err);
        alert('Something went wrong');
      });
    }
  }
</script>

</body>
</html>